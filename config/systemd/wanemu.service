[Unit]
Description=WAN emulator web panel (netem)
After=network-online.target networking.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wanemu
Environment=PYTHONUNBUFFERED=1
Environment=WANEMU_CONFIG=/etc/wanemu/config.yaml
ExecStart=/usr/bin/python3 -m uvicorn wanemu.main:app --host 0.0.0.0 --port @PANEL_PORT@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
